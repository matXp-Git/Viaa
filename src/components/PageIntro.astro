---
interface Props {
  eyebrow: string;
  title: string;
  overlayLead?: string;
  overlayMeta?: string[];
}

const { eyebrow, title, overlayLead, overlayMeta = [] } = Astro.props;
const hasImage = Astro.slots.has('image');
const hasOverlay = hasImage && Boolean(overlayLead);
---

<section class={`page-intro ${hasImage ? 'page-intro--with-image' : ''}`}>
  <div class={hasImage ? 'page-intro__grid' : 'container'}>
    <div class={hasImage ? 'page-intro__text' : ''}>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="page-intro__title">{title}</h1>
      <div class="page-intro__body">
        <slot />
      </div>
    </div>

    {hasImage && (
      <div class="page-intro__visual">
        <slot name="image" />

        {hasOverlay && (
          <div class="page-intro__overlay">
            <p class="page-intro__overlay-lead">{overlayLead}</p>
            <div class="page-intro__overlay-meta">
              {overlayMeta.map((line) => (
                <p class="data-label">
                  {line.replace(/\s*\/\s*Active$/i, '') !== line && (
                    <span class="status-dot"></span>
                  )}
                  {line}
                </p>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .page-intro {
    padding-block: 0 clamp(48px, 7vw, 80px);
  }

  .page-intro__title {
    margin-top: 16px;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    line-height: 1.1;
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-charcoal);
    max-width: 820px;
  }

  .page-intro__body {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 62ch;
    font-size: 1.05rem;
    line-height: 1.6;
    opacity: 0.85;
  }

  .page-intro--with-image {
    padding-bottom: 0;
  }

  .page-intro__grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    align-items: stretch;
    gap: clamp(32px, 5vw, 64px);
    width: 100%;
  }

  .page-intro__text {
    padding-left: max(var(--gutter), calc((100vw - var(--container-max)) / 2 + var(--gutter)));
    padding-right: var(--gutter);
    padding-block: clamp(40px, 6vw, 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .page-intro__text .page-intro__title,
  .page-intro__text .page-intro__body {
    max-width: 100%;
  }

  .page-intro__visual {
    position: relative;
    min-height: 340px;
  }

  .page-intro__visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-intro__overlay {
    position: absolute;
    inset: 0;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--color-white);
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 35%);
  }

  .page-intro__overlay-lead {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .page-intro__overlay-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .page-intro__overlay .data-label {
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0.85;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(235, 237, 56, 0.25);
  }

  @media (max-width: 900px) {
    .page-intro__grid {
      grid-template-columns: 1fr;
    }

    .page-intro__text {
      padding-right: var(--gutter);
    }

    .page-intro__visual {
      min-height: 320px;
    }
  }
</style>
