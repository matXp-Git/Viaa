---
const navItems = [
  { label: 'Collectivités', href: '/collectivites' },
  { label: 'Acteurs privés', href: '/acteurs-prives' },
  { label: 'Notre méthode', href: '/notre-methode' },
  { label: 'Le terrain', href: '/le-terrain' },
];

const pathname = Astro.url.pathname;
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="logo">
      <img src="/logo-viia.svg" alt="Viia" class="logo__mark" />
      <span class="logo__dot">.</span>
      <span class="logo__product data-label">PICK</span>
    </a>

    <nav class="nav" aria-label="Navigation principale">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`nav__link data-label ${pathname === item.href ? 'nav__link--active' : ''}`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a href="/contact" class="btn btn-accent">Contact →</a>
  </div>
</header>

<style>
  .header {
    padding-block: 24px;
    border-bottom: 1px solid var(--color-line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    color: var(--color-charcoal);
  }

  .logo__mark {
    height: 25px;
    width: auto;
    display: block;
  }

  .logo__dot {
    color: var(--color-accent);
    -webkit-text-stroke: 1px var(--color-charcoal);
    margin-right: -6px;
  }

  .logo__product {
    color: var(--color-charcoal);
    opacity: 0.55;
    font-weight: 400;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .nav__link {
    color: var(--color-charcoal);
    opacity: 0.75;
    padding: 6px 10px;
    border-radius: 0;
    transition: opacity 0.15s ease, background 0.15s ease, color 0.15s ease;
  }

  .nav__link:hover {
    opacity: 1;
  }

  .nav__link--active {
    color: var(--color-charcoal);
    background: color-mix(in srgb, var(--color-accent) 70%, transparent);
    opacity: 1;
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
  }
</style>
