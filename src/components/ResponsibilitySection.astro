---
const indicators = [
  { label: 'Eau', value: '18 m³ / an' },
  { label: 'Énergie', value: '2 400 kWh / an' },
  { label: 'Déplacements', value: '3 000 km / an' },
  { label: 'Recyclage / Valorisation', value: '96 %' },
  { label: 'Outillages électriques / manuels', value: '80 % électrique' },
];
---

<section class="responsibility">
  <div class="container">
    <p class="eyebrow eyebrow--light">Responsabilité</p>
    <h2 class="responsibility__title">Mesurer l'impact. Publier les résultats.</h2>

    <div class="responsibility__grid">
      <div>
        <p class="responsibility__text">
          Viia suit les résultats environnementaux de son activité et souhaite les rendre utiles
          au client. Un rapport annuel chiffré permet de documenter les progrès réalisés en
          matière d'environnement.
        </p>
        <p class="responsibility__text">
          Les données environnementales peuvent être utilisées dans les propres rapports et
          démarches environnementales du client.
        </p>
      </div>

      <div class="responsibility__indicators">
        <p class="data-label responsibility__indicators-label">Indicateurs suivis</p>
        <ul class="responsibility__list">
          {indicators.map((indicator) => (
            <li>
              <span class="data-label">{indicator.label}</span>
              <span class="data-label responsibility__value">{indicator.value}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .responsibility {
    background: var(--color-charcoal);
    color: var(--color-white);
    padding-block: clamp(64px, 8vw, 96px);
  }

  .eyebrow--light {
    color: var(--color-white);
    opacity: 0.8;
  }

  .responsibility__title {
    margin-top: 16px;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 400;
    text-transform: uppercase;
    max-width: 640px;
  }

  .responsibility__grid {
    margin-top: clamp(32px, 5vw, 48px);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 5vw, 64px);
  }

  .responsibility__text {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.75;
    margin-bottom: 14px;
    max-width: 50ch;
  }

  .responsibility__indicators-label {
    opacity: 0.5;
    margin-bottom: 16px;
  }

  .responsibility__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .responsibility__list li {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-top: 1px solid var(--color-line-dark);
  }

  .responsibility__list li:last-child {
    border-bottom: 1px solid var(--color-line-dark);
  }

  .responsibility__value {
    color: var(--color-accent);
    opacity: 1;
    text-transform: none;
    letter-spacing: 0;
  }

  @media (max-width: 900px) {
    .responsibility__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
