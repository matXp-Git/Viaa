---
interface Props {
  eyebrow: string;
  title: string;
  items: string[];
}

const { eyebrow, title, items } = Astro.props;
---

<section class="checklist">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="checklist__title">{title}</h2>

    <ul class="checklist__list">
      {items.map((item, i) => (
        <li class="checklist__item">
          <span class="data-label checklist__index">{String(i + 1).padStart(2, '0')}</span>
          <span class="checklist__text">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .checklist {
    padding-block: clamp(56px, 8vw, 88px);
    border-top: 1px solid var(--color-line);
  }

  .checklist__title {
    margin-top: 16px;
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    font-weight: 400;
    text-transform: uppercase;
    max-width: 640px;
  }

  .checklist__list {
    margin: clamp(32px, 5vw, 48px) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .checklist__item {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 18px 0;
    border-top: 1px solid var(--color-line);
    max-width: 720px;
  }

  .checklist__item:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .checklist__index {
    flex: 0 0 auto;
    opacity: 0.45;
  }

  .checklist__text {
    font-size: 1rem;
    line-height: 1.55;
  }
</style>
