---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'editorial'>;
}

const { entry } = Astro.props;
const { title, excerpt, coverImage, coverImageAlt, category, date } = entry.data;

const formattedDate = date.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<a href={`/editorial/${entry.id}`} class="article-card">
  <div class="article-card__visual">
    <Image src={coverImage} alt={coverImageAlt} width={600} height={400} />
  </div>
  <div class="article-card__body">
    <p class="data-label article-card__meta">{category} — {formattedDate}</p>
    <h2 class="article-card__title">{title}</h2>
    <p class="article-card__excerpt">{excerpt}</p>
    <span class="link-arrow">Lire l'article →</span>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .article-card__visual {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-black);
  }

  .article-card__visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .article-card:hover .article-card__visual :global(img) {
    transform: scale(1.03);
  }

  .article-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  .article-card__meta {
    opacity: 0.5;
  }

  .article-card__title {
    font-size: 1.3rem;
    line-height: 1.25;
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-charcoal);
  }

  .article-card__excerpt {
    font-size: 0.95rem;
    line-height: 1.55;
    opacity: 0.75;
  }
</style>
